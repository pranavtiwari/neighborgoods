rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Public read for all files (images are displayed to users)
      allow read: if true;

      // Write: must be authenticated, file must be an image, max 5MB
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   // Users may only write to their own path: items/{uid}/... or avatars/{uid}
                   && (resource == null || resource.metadata['uploadedBy'] == request.auth.uid);

      // Delete: only the uploader may delete their own files
      allow delete: if request.auth != null
                    && resource.metadata['uploadedBy'] == request.auth.uid;
    }
  }
}
