rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles: Everyone can read, authenticated users can write their own profile
    // Profiles: Everyone can read, owner can write, or anyone logged in can update reputation_score
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == profileId;
      allow update: if request.auth != null && (request.auth.uid == profileId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reputation_score']));
      allow delete: if request.auth != null && request.auth.uid == profileId;
    }
    
    // Circles: Everyone can read, authenticated users can write
    match /circles/{circleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Circle Members: Anyone logged in can read and write circle memberships
    match /circle_members/{membershipId} {
      allow read, write: if request.auth != null;
    }
    
    // Items: Everyone can read, authenticated users can write
    match /items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Borrow Requests: Anyone logged in can read and write requests
    match /requests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // Circle Posts: Everyone can read, authenticated users can write
    match /circle_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Messages: Users can only read and write messages if they are a participant (sender or receiver)
    match /messages/{messageId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.receiver_id);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.sender_id;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.receiver_id);
    }

    // Circle Join Requests: authenticated users can read, create, and delete requests
    match /circle_join_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Ratings: Everyone can read, authenticated users can write (create ratings)
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.rater_id;
      allow update, delete: if false;
    }
  }
}
