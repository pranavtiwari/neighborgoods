rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles: Everyone can read, owner can write (except reputation_score), or other users can update reputation_score within 1.0-5.0
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == profileId && (!('reputation_score' in request.resource.data) || request.resource.data.reputation_score == 5.0);
      allow update: if request.auth != null && (
        (request.auth.uid == profileId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputation_score']) || request.resource.data.reputation_score == resource.data.reputation_score)) ||
        (request.auth.uid != profileId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reputation_score']) && request.resource.data.reputation_score is number && request.resource.data.reputation_score >= 1.0 && request.resource.data.reputation_score <= 5.0)
      );
      allow delete: if request.auth != null && request.auth.uid == profileId;
    }
    
    // Circles: Everyone can read, creator can write
    match /circles/{circleId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.created_by == request.auth.uid;
      allow update: if request.auth != null && resource.data.created_by == request.auth.uid && request.resource.data.created_by == resource.data.created_by;
      allow delete: if request.auth != null && resource.data.created_by == request.auth.uid;
    }
    
    // Circle Members: Anyone logged in can read, but can only create/delete their own membership OR if they are the circle creator
    match /circle_members/{membershipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.profile_id == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(request.resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.profile_id == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow update: if request.auth != null;
    }
    
    // Items: Everyone can read, owner can write
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner_id == request.auth.uid && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }
    
    // Borrow Requests: Borrower and lender can read/write
    match /requests/{requestId} {
      allow read, write: if request.auth != null && (
        resource.data.borrower_id == request.auth.uid || 
        resource.data.lender_id == request.auth.uid ||
        request.resource.data.borrower_id == request.auth.uid || 
        request.resource.data.lender_id == request.auth.uid
      );
    }
    
    // Circle Posts: Everyone can read, author can write, other members can reply or toggle helpful
    match /circle_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.profile_id == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.profile_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'helpful_by'])
      );
      allow delete: if request.auth != null && resource.data.profile_id == request.auth.uid;
    }
    
    // Messages: Users can only read and write messages if they are a participant (sender or receiver)
    match /messages/{messageId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.receiver_id);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.sender_id;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.receiver_id && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
      );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.receiver_id);
    }

    // Circle Join Requests: authenticated users can read, request creator can create, any member can process/delete
    match /circle_join_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.profile_id == request.auth.uid;
      allow delete: if request.auth != null;
    }
    
    // Ratings: Everyone can read, authenticated users can write (create ratings)
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.rater_id;
      allow update, delete: if false;
    }
  }
}
