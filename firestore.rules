rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper: may `uid` write the lifecycle fields of `itemId`?
    //
    // Firestore security rules have NO query primitive. `get()` and `exists()`
    // accept a single document path only; chaining `.where()`/`.limit()` off
    // `get()` is a hard evaluation error, not a runtime failure. The earlier
    // form of this helper did exactly that, so every borrower-side lifecycle
    // write (markPickedUp / markReturned / undo*) was denied in production
    // regardless of request status — items were stuck at 'approved' forever.
    //
    // Rules can only read one document at a time, so the item denormalises
    // `active_request_id` (written by the item OWNER when a request is
    // approved) and we read that single request. A non-owner may never change
    // it: the field is outside their lifecycle allow-list below.
    //
    // `active_request_id` is cleared back to null when the request reaches a
    // terminal state, so access stops even though the request still exists.
    //
    // Two subtleties cost real debugging time here:
    //  - snapshots returned by `get()` do NOT expose `.exists`; the guard is
    //    the free-function `exists(path)`, and `&&` short-circuits so the
    //    `get()` is never evaluated against a missing document.
    //  - the path must be written twice because there is no binding for it.
    // ─────────────────────────────────────────────────────────────────────────
    function canParticipantUpdateItem(itemId, activeRequestId) {
      return exists(/databases/$(database)/documents/requests/$(activeRequestId))
        && (get(/databases/$(database)/documents/requests/$(activeRequestId)).data.item_id == itemId
            || ('offered_item_id' in get(/databases/$(database)/documents/requests/$(activeRequestId)).data
                && get(/databases/$(database)/documents/requests/$(activeRequestId)).data.offered_item_id == itemId))
        && (get(/databases/$(database)/documents/requests/$(activeRequestId)).data.borrower_id == request.auth.uid
            || get(/databases/$(database)/documents/requests/$(activeRequestId)).data.lender_id == request.auth.uid
            || ('participant_ids' in get(/databases/$(database)/documents/requests/$(activeRequestId)).data
                && request.auth.uid in get(/databases/$(database)/documents/requests/$(activeRequestId)).data.participant_ids))
        && get(/databases/$(database)/documents/requests/$(activeRequestId)).data.status
             in ['pending', 'approved', 'borrowed', 'returned', 'shipped', 'delivered'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Item Visibility & Request Policy Helpers (Issue #18)
    // ─────────────────────────────────────────────────────────────────────────
    function canUserReadItem(itemData) {
      return !('visibility' in itemData)
        || itemData.visibility == 'public'
        || (request.auth != null && (
             itemData.owner_id == request.auth.uid
             || (itemData.visibility == 'circles' && (
                  ('circle_id' in itemData && itemData.circle_id != null
                   && exists(/databases/$(database)/documents/circle_members/$(itemData.circle_id + '_' + request.auth.uid)))
                  || ('circle_ids' in itemData && itemData.circle_ids.size() > 0
                      && exists(/databases/$(database)/documents/circle_members/$(itemData.circle_ids[0] + '_' + request.auth.uid)))
                ))
             || (itemData.visibility == 'trusted'
                 && 'trusted_user_ids' in itemData
                 && request.auth.uid in itemData.trusted_user_ids)
           ));
    }

    function canUserRequestItem(itemId) {
      return !exists(/databases/$(database)/documents/items/$(itemId))
        || (
          canUserReadItem(get(/databases/$(database)/documents/items/$(itemId)).data)
          && (
            !('request_policy' in get(/databases/$(database)/documents/items/$(itemId)).data)
            || get(/databases/$(database)/documents/items/$(itemId)).data.request_policy == 'anyone'
            || (
              get(/databases/$(database)/documents/items/$(itemId)).data.request_policy == 'circle_members'
              && (
                ('circle_id' in get(/databases/$(database)/documents/items/$(itemId)).data
                 && get(/databases/$(database)/documents/items/$(itemId)).data.circle_id != null
                 && exists(/databases/$(database)/documents/circle_members/$(get(/databases/$(database)/documents/items/$(itemId)).data.circle_id + '_' + request.auth.uid)))
                || ('circle_ids' in get(/databases/$(database)/documents/items/$(itemId)).data
                    && get(/databases/$(database)/documents/items/$(itemId)).data.circle_ids.size() > 0
                    && exists(/databases/$(database)/documents/circle_members/$(get(/databases/$(database)/documents/items/$(itemId)).data.circle_ids[0] + '_' + request.auth.uid)))
              )
            )
            || (
              get(/databases/$(database)/documents/items/$(itemId)).data.request_policy == 'trusted_only'
              && 'trusted_user_ids' in get(/databases/$(database)/documents/items/$(itemId)).data
              && request.auth.uid in get(/databases/$(database)/documents/items/$(itemId)).data.trusted_user_ids
            )
          )
        );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Profiles
    // FIX VULN-01: Removed the branch that let any authenticated user write
    //              reputation_score directly. Reputation is now immutable from
    //              the client; it must be updated by a Cloud Function triggered
    //              by a new rating document.
    // ─────────────────────────────────────────────────────────────────────────
    match /profiles/{profileId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == profileId
        // reputation_score may only be set to 5.0 (default) on creation
        && (!('reputation_score' in request.resource.data) || request.resource.data.reputation_score == 5.0)
        // carbon_saved_kg must start at 0
        && (!('carbon_saved_kg' in request.resource.data) || request.resource.data.carbon_saved_kg == 0)
        // Basic field type guards
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        // `bio` is optional on create (never all callers supply it), but must
        // be a bounded string when present.
        && (!('bio' in request.resource.data) || (
              request.resource.data.bio is string
              && request.resource.data.bio.size() <= 2000));

      allow update: if request.auth != null
        && request.auth.uid == profileId
        // Owner CANNOT change reputation_score directly (Cloud Function only)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputation_score'])
        // FIX VULN-14: carbon_saved_kg is the same class of server-owned
        // aggregate as reputation_score. confirmReturn used to credit BOTH
        // the lender and the borrower, so the counterparty's write was denied
        // by the rule above and the whole return confirmation failed in
        // production. Impact is now recorded as an append-only `impact_events`
        // row and folded into the profile by a trusted process.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['carbon_saved_kg'])
        // Basic field type guards
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && (!('bio' in request.resource.data) || (
              request.resource.data.bio is string
              && request.resource.data.bio.size() <= 2000));

      allow delete: if request.auth != null && request.auth.uid == profileId;
    }

// ─────────────────────────────────────────────────────────────────────────
// Firestore Indexes required by these rules
//
// Security rules are only evaluated for queries the backend can actually
// serve. `isRequestParticipant()` above issues item_id + status IN [...] +
// party, which needs these composite indexes. Without them a non-owner
// lifecycle write is rejected by the BACKEND (FAILED_PRECONDITION /
// "query requires an index"), not by the rule, which is very hard to
// diagnose. See firestore/indexes.json.
// ─────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────
// Impact Events (append-only ledger)
    // Replaces the illegal cross-profile carbon_saved_kg write. One row per
    // participant per completed transfer; carbon is DERIVED from these rows.
    // ─────────────────────────────────────────────────────────────────────────
    match /impact_events/{eventId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.beneficiary_id is string
        && request.resource.data.beneficiary_id.size() > 0
        && request.resource.data.credit_kg is number
        && request.resource.data.credit_kg <= 10
        // A credit is positive and names a real beneficiary; a reversal is
        // negative and parks on the reserved 'none' beneficiary. Neither can
        // be a large magnitude, and a reversal must point at what it undoes.
        && (
             (request.resource.data.credit_kg > 0
               && request.resource.data.kind in ['loan', 'donation', 'swap'])
          || (request.resource.data.credit_kg < 0
               && request.resource.data.kind == 'reversal'
               && request.resource.data.reverses_event_id is string)
        );

      // Immutable: a ledger entry cannot be rewritten or removed.
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Circles: Everyone can read, creator can write
    // ─────────────────────────────────────────────────────────────────────────
    // ─────────────────────────────────────────────────────────────────────────
    // Transaction Events (immutable audit log)
    // ─────────────────────────────────────────────────────────────────────────
    match /transaction_events/{eventId} {
      // Participants or circle admins may read transaction events
      allow read: if request.auth != null && (
        resource.data.actor_id == request.auth.uid ||
        resource.data.borrower_id == request.auth.uid ||
        resource.data.lender_id == request.auth.uid ||
        ('participant_ids' in resource.data && request.auth.uid in resource.data.participant_ids) ||
        ('circle_id' in resource.data && resource.data.circle_id != null &&
         exists(/databases/$(database)/documents/circles/$(resource.data.circle_id)) &&
         get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid)
      );

      allow create: if request.auth != null
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.request_id is string
        && request.resource.data.item_id is string
        && request.resource.data.event_type is string;

      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid;
      allow update: if request.auth != null
        && (
          (resource.data.created_by == request.auth.uid
            && request.resource.data.created_by == resource.data.created_by)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_count', 'updated_at'])
              && request.resource.data.created_by == resource.data.created_by)
        );
      allow delete: if request.auth != null
        && resource.data.created_by == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Circle Members
    // FIX VULN-03: Replaced `allow update: if request.auth != null` (which let
    //              any user escalate their own role to admin) with a rule that
    //              only allows the circle creator to update memberships, and
    //              prevents changing identity fields.
    // FIX VULN-09: Self-join is only permitted with role:'member' to prevent
    //              self-assignment of admin on creation.
    // ─────────────────────────────────────────────────────────────────────────
    match /circle_members/{membershipId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        // Self-join: must declare role as 'member' only
        (request.resource.data.profile_id == request.auth.uid
          && request.resource.data.role == 'member') ||
        // Circle creator can add anyone with any role
        get(/databases/$(database)/documents/circles/$(request.resource.data.circle_id)).data.created_by == request.auth.uid
      );

      allow delete: if request.auth != null && (
        resource.data.profile_id == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
      );

      // Only circle creator may update memberships (e.g. change role)
      // Identity fields (circle_id, profile_id) are immutable after creation
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['circle_id', 'profile_id'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['member', 'librarian', 'admin']);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Items: Everyone can read, owner can write
    // FIX VULN-11: Added basic field type and size validation to prevent
    //              garbage data, DoS via huge strings, or XSS stored via
    //              image_url (defense-in-depth alongside frontend sanitisation).
    // ─────────────────────────────────────────────────────────────────────────
    match /items/{itemId} {
      allow read: if canUserReadItem(resource.data);

      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && (!('description' in request.resource.data) || (
              request.resource.data.description is string
              && request.resource.data.description.size() <= 5000))
        && (!('image_url' in request.resource.data) || request.resource.data.image_url is string)
        // V1 listing types only. Legacy 'free'/'rental' rows stay readable but
        // no new rental can be created.
        && (!('listing_type' in request.resource.data) || (
              request.resource.data.listing_type in ['borrow', 'giveaway', 'swap']))
        && (!('kind' in request.resource.data) || (
              request.resource.data.kind in ['book', 'item', 'skill', 'surplus']))
        // A physical book copy must be linked to a canonical book; owner_id is
        // already required to be the authenticated user above.
        && (!('kind' in request.resource.data) || request.resource.data.kind != 'book' || (
              request.resource.data.book_id is string
              && request.resource.data.book_id.size() > 0))
        && (!('visibility' in request.resource.data) || (
              request.resource.data.visibility in ['public', 'circles', 'trusted']))
        && (!('request_policy' in request.resource.data) || (
              request.resource.data.request_policy in ['anyone', 'circle_members', 'trusted_only']))
        && (!('trusted_user_ids' in request.resource.data) || (
              request.resource.data.trusted_user_ids is list));

      // FIX VULN-13: The original rule only let the OWNER update an item, but
      // the borrow lifecycle mutates item.status / is_available from both
      // sides: the lender (confirm/decline) and the borrower
      // (markPickedUp / markReturned). Those borrower-side writes were denied,
      // so `markPickedUp` failed against real Firestore and items were stuck
      // at status:'approved' forever.
      //
      // A participant may change ONLY the lifecycle fields. owner_id, name,
      // and all descriptive data remain owner-only, and `active_request_id`
      // is deliberately outside the allow-list so a borrower cannot repoint
      // the item at a request of their own choosing.
      allow update: if request.auth != null
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && (!('description' in request.resource.data) || (
              request.resource.data.description is string
              && request.resource.data.description.size() <= 5000))
        // No new rentals on edit. Legacy rows that leave listing_type untouched
        // remain editable for migration/cleanup.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['listing_type']) || (
              request.resource.data.listing_type in ['borrow', 'giveaway', 'swap']))
        && (!request.resource.data.keys().hasAny(['kind']) || request.resource.data.kind != 'book' || (
              request.resource.data.book_id is string
              && request.resource.data.book_id.size() > 0))
        && (!('visibility' in request.resource.data) || (
              request.resource.data.visibility in ['public', 'circles', 'trusted']))
        && (!('request_policy' in request.resource.data) || (
              request.resource.data.request_policy in ['anyone', 'circle_members', 'trusted_only']))
        && (!('trusted_user_ids' in request.resource.data) || (
              request.resource.data.trusted_user_ids is list))
        && (
          // Owner may rewrite the listing freely.
          resource.data.owner_id == request.auth.uid
          // Librarian or admin may update book_id (merge) or withdrawal fields
          || (
            (exists(/databases/$(database)/documents/librarians/$(request.auth.uid))
             || (request.auth.token != null && request.auth.token.admin == true))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['book_id', 'is_withdrawn', 'is_available', 'status', 'withdrawal_reason', 'withdrawn_by', 'withdrawn_at', 'updated_at'])
          )
          // A borrower/lender may only advance the lifecycle, and only while
          // the single denormalised request they were granted is in flight.
          || (
            resource.data.keys().hasAny(['active_request_id'])
            && resource.data.active_request_id is string
            && canParticipantUpdateItem(itemId, resource.data.active_request_id)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'is_available', 'active_request_id', 'updated_at'])
            && (!('active_request_id' in request.resource.data)
                || request.resource.data.active_request_id == null
                || request.resource.data.active_request_id == resource.data.active_request_id)
          )
        );

      allow delete: if request.auth != null
        && resource.data.owner_id == request.auth.uid;

      // ───────────────────────────────────────────────────────────────────────
      // Private Location & Sensitive Pickup Details (Issue #6)
      // Readable ONLY by item owner and the approved borrower of an active transaction.
      // ───────────────────────────────────────────────────────────────────────
      match /private/{docId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/items/$(itemId)).data.owner_id == request.auth.uid
          || (
            get(/databases/$(database)/documents/items/$(itemId)).data.keys().hasAny(['active_request_id'])
            && exists(/databases/$(database)/documents/requests/$(get(/databases/$(database)/documents/items/$(itemId)).data.active_request_id))
            && ((get(/databases/$(database)/documents/requests/$(get(/databases/$(database)/documents/items/$(itemId)).data.active_request_id)).data.borrower_id == request.auth.uid
                || ('participant_ids' in get(/databases/$(database)/documents/requests/$(get(/databases/$(database)/documents/items/$(itemId)).data.active_request_id)).data
                    && request.auth.uid in get(/databases/$(database)/documents/requests/$(get(/databases/$(database)/documents/items/$(itemId)).data.active_request_id)).data.participant_ids))
            && get(/databases/$(database)/documents/requests/$(get(/databases/$(database)/documents/items/$(itemId)).data.active_request_id)).data.status
                 in ['approved', 'borrowed', 'shipped', 'delivered', 'returned', 'completed']
          )
        );

        allow write: if request.auth != null
          && get(/databases/$(database)/documents/items/$(itemId)).data.owner_id == request.auth.uid;
      }

    }

    // ─────────────────────────────────────────────────────────────────────────
    // Borrow Requests
    // FIX VULN-02: Replaced the single `read, write` rule (which allowed
    //              lender impersonation on create, self-approval on update,
    //              and field tampering) with granular create/read/update rules.
    //              - create: only borrower, status must be 'pending', no self-borrow
    //              - update: identity fields immutable; lender controls status
    //                        transitions, borrower controls pickup/return timestamps
    //              - delete: disabled to preserve audit trail
    // ─────────────────────────────────────────────────────────────────────────
    match /requests/{requestId} {
      // Only borrower, lender, participants or circle admin may read requests
      allow read: if request.auth != null && (
        resource.data.borrower_id == request.auth.uid ||
        resource.data.lender_id == request.auth.uid ||
        ('participant_ids' in resource.data && request.auth.uid in resource.data.participant_ids) ||
        ('circle_id' in resource.data && resource.data.circle_id != null &&
         exists(/databases/$(database)/documents/circles/$(resource.data.circle_id)) &&
         get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid)
      );

      // Only borrower/requester may create; must be pending; cannot transact with self
      allow create: if request.auth != null
        && request.resource.data.borrower_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.lender_id is string
        && request.resource.data.lender_id != request.auth.uid
        && (!('item_id' in request.resource.data) || (
              request.resource.data.item_id is string
              && canUserRequestItem(request.resource.data.item_id)
            ));

      // Updates: identity fields are immutable; role-based field restrictions
      allow update: if request.auth != null
        // Prevent tampering with ownership
        && request.resource.data.borrower_id == resource.data.borrower_id
        && request.resource.data.lender_id == resource.data.lender_id
        && (
          // Lender may change status and confirmation timestamps
          (resource.data.lender_id == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'confirmed_at', 'declined_at', 'picked_up_at',
                       'returned_at', 'completed_at', 'donated_at', 'cancelled_at',
                       'shipped_at', 'delivered_at', 'timeline', 'last_event_id',
                       'last_event_type', 'updated_at', 'tracking_number', 'carrier',
                       'lender_confirmed_at', 'owner_confirmed_at', 'return_due_date'])) ||
          // Borrower may acknowledge pickup/shipping/return or cancel
          (resource.data.borrower_id == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'picked_up_at', 'returned_at', 'cancelled_at',
                       'shipped_at', 'delivered_at', 'timeline', 'last_event_id',
                       'last_event_type', 'updated_at', 'tracking_number', 'carrier',
                       'borrower_confirmed_at', 'requester_confirmed_at'])) ||
          // Librarian or admin repointing book_id during book merge
          ((exists(/databases/$(database)/documents/librarians/$(request.auth.uid))
            || (request.auth.token != null && request.auth.token.admin == true)) &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['book_id', 'updated_at']))
        );

      // Disable deletion to maintain audit trail
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Circle Posts
    // FIX VULN-06: create now requires circle membership. update now requires
    //              membership to modify replies/helpful_by, and the post author
    //              cannot change identity fields (profile_id, circle_id).
    // ─────────────────────────────────────────────────────────────────────────
    match /circle_posts/{postId} {
      allow read: if !('circle_id' in resource.data)
        || !get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.is_private
        || (request.auth != null && exists(/databases/$(database)/documents/circle_members/$(resource.data.circle_id + '_' + request.auth.uid)));

      // Only circle members may post
      allow create: if request.auth != null
        && request.resource.data.profile_id == request.auth.uid
        && exists(/databases/$(database)/documents/circle_members/$(request.resource.data.circle_id + '_' + request.auth.uid));

      allow update: if request.auth != null && (
        // Post author can edit content but not identity fields
        (resource.data.profile_id == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profile_id', 'circle_id'])) ||
        // Circle members can only modify replies and helpful_by
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'helpful_by'])
          && exists(/databases/$(database)/documents/circle_members/$(resource.data.circle_id + '_' + request.auth.uid)))
      );

      allow delete: if request.auth != null
        && resource.data.profile_id == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Messages
    // FIX VULN-12: Added content size limit (5000 chars) to prevent DoS via
    //              oversized messages.
    // ─────────────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.sender_id
            || request.auth.uid == resource.data.receiver_id);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.sender_id
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000;

      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.receiver_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])) ||
        ((request.auth.uid == resource.data.sender_id || request.auth.uid == resource.data.receiver_id)
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['circle_id', 'circle_ids']))
      );

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.sender_id
            || request.auth.uid == resource.data.receiver_id);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Circle Join Requests
    // FIX VULN-04: Replaced `allow delete: if request.auth != null` (any user
    //              could delete anyone's join request) with a rule scoped to
    //              the requester or the circle's creator.
    // ─────────────────────────────────────────────────────────────────────────
    match /circle_join_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.profile_id == request.auth.uid;
      allow delete: if request.auth != null && (
        // Requester can cancel their own pending request
        resource.data.profile_id == request.auth.uid ||
        // Circle creator can approve/deny (delete) any request for their circle
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Ratings
    // FIX VULN-05: Added self-rating prevention, score range validation,
    //              type checks, and required field enforcement.
    // ─────────────────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null
        // Rater must be the authenticated user
        && request.auth.uid == request.resource.data.rater_id
        // Cannot rate yourself
        && request.resource.data.ratee_id is string
        && request.resource.data.ratee_id != request.auth.uid
        // Score must be an integer/float between 1 and 5
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        // A request_id linking to a real transaction must be provided
        && request.resource.data.request_id is string
        // All required fields must be present
        && request.resource.data.keys().hasAll(['rater_id', 'ratee_id', 'score', 'request_id']);

      // Ratings are immutable once created
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Books (Issue #7: Canonical Book Catalog)
    // ─────────────────────────────────────────────────────────────────────────
    match /books/{bookId} {
      // 1. Public read: Anyone can read canonical book records
      allow read: if true;

      // 2. Authenticated create
      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 500
        && request.resource.data.title_normalized is string
        && request.resource.data.title_normalized.size() >= 1
        && request.resource.data.title_normalized.size() <= 500
        && request.resource.data.authors is list
        && request.resource.data.isbns is list
        && request.resource.data.copies_count is int
        && request.resource.data.copies_count >= 0
        && request.resource.data.available_copies_count is int
        && request.resource.data.available_copies_count >= 0
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      // 3. Authenticated update: metadata edits, merging, and copy count sync
      allow update: if request.auth != null
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.created_by == resource.data.created_by
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']) || (
              request.resource.data.title is string
              && request.resource.data.title.size() >= 1
              && request.resource.data.title.size() <= 500))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title_normalized']) || (
              request.resource.data.title_normalized is string
              && request.resource.data.title_normalized.size() >= 1
              && request.resource.data.title_normalized.size() <= 500))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['copies_count']) || (
              request.resource.data.copies_count is int
              && request.resource.data.copies_count >= 0))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['available_copies_count']) || (
              request.resource.data.available_copies_count is int
              && request.resource.data.available_copies_count >= 0))
        && (!('is_merged' in request.resource.data) || request.resource.data.is_merged is bool)
        && (!('merged_into' in request.resource.data) || request.resource.data.merged_into is string)
        && request.resource.data.updated_at == request.time;

      // 4. Delete: Disallow deleting books
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Reports (Issue #20: Moderation & Report Queue)
    // ─────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolution', 'resolved_by', 'action_taken', 'resolved_at', 'updated_at']);
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Moderation Events (Issue #20: Audit Trail)
    // ─────────────────────────────────────────────────────────────────────────
    match /moderation_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Librarians (Issue #20: Appointed Librarians)
    // ─────────────────────────────────────────────────────────────────────────
    match /librarians/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Analytics Events & Launch Metrics (Issue #22: Soft Launch Instrumentation)
    // ─────────────────────────────────────────────────────────────────────────
    match /analytics_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.event_type is string
        && request.resource.data.event_type.size() >= 1;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Seed Feedback (Issue #22: Feedback Path for Seed Users)
    // ─────────────────────────────────────────────────────────────────────────
    match /seed_feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.comment is string;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Feature Flags (Issue #22: Rollout Feature Flags)
    // ─────────────────────────────────────────────────────────────────────────
    match /feature_flags/{flagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Notifications (Issue #24: Notifications and Reminders)
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipient_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.recipient_id is string;
      allow update: if request.auth != null && resource.data.recipient_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.recipient_id == request.auth.uid;
    }
  }
}

